# =============================================================================
# Variáveis lidas pelo docker-compose (substituição ${VAR}).
# Copie para .env:  cp .env.example .env
# NUNCA versione o .env real. Troque todos os CHANGE_ME_IN_PRODUCTION.
# =============================================================================

APP_ENV=local
APP_DEBUG=true
APP_PORT=8000
FRONTEND_PORT=5173

# ── Banco de dados (MySQL) ──
DB_DATABASE=orders
DB_USERNAME=orders
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_PORT=3306

# ── Redis ──
REDIS_PORT=6379

# ── N8N (credenciais do painel e webhook consumido pela API) ──
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_IN_PRODUCTION
N8N_WEBHOOK_URL=http://n8n:5678/webhook/order-status-changed
