APP_NAME="Orders"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados (local: 127.0.0.1 | docker: sobrescrito para host "mysql")
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orders
DB_USERNAME=orders
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Filas e cache via Redis (predis — cliente PHP puro, sem extensão nativa)
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── API externa (fakestoreapi) ──
FAKESTORE_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT=15
FAKESTORE_RETRIES=3
FAKESTORE_RETRY_BACKOFF=200
FAKESTORE_RATE_LIMIT=30
FAKESTORE_PAGE_SIZE=50

# ── N8N (notificações) ──
# URL do webhook do N8N chamada pelo job de notificação após cada transição.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/order-status-changed
